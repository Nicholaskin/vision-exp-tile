{
  "$schema": "https://raw.githubusercontent.com/Yan-Zero/dsh-std/main/packages/manifest/schema/dsh-plugin-0.15.schema.json",
  "manifestVersion": "0.15",
  "id": "vision.tile",
  "name": "vision-exp-tile",
  "version": "0.5.0-rc.1",
  "facets": {
    "host": {
      "entry": "./std-facet.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": []
  },
  "permissions": [],
  "contributes": {
    "x-tools": [
      {
        "apiVersion": "tools.dsh/v1alpha1",
        "kind": "Tool",
        "id": "vision.tile.split",
        "name": "vision_tile_split",
        "spec": {
          "title": "大图切块",
          "description": "把一张大图按正方形网格切成 800×800 无损小块并标注原图坐标，输出分块聚合逻辑；不调用视觉 API。"
        }
      },
      {
        "apiVersion": "tools.dsh/v1alpha1",
        "kind": "Tool",
        "id": "vision.tile.recognize",
        "name": "vision_tile_recognize",
        "spec": {
          "title": "智能识图",
          "description": "切图后直连 DeepSeek 视觉 API 识别并聚合：整图预检 → 本地 OCR + 重点区域切块识别 → 汇总。"
        }
      },
      {
        "apiVersion": "tools.dsh/v1alpha1",
        "kind": "Tool",
        "id": "vision.tile.region-crop",
        "name": "vision_region_crop",
        "spec": {
          "title": "区域裁剪识别",
          "description": "按预检返回的相对矩形裁剪原图区域，可落盘或直读视觉 API 识别（识别失败自动降级为本地 OCR 文本）。"
        }
      }
    ]
  },
  "license": "MIT",
  "source": {
    "repository": "https://github.com/Nicholaskin/vision-exp-tile.git"
  },
  "compat": {
    "hosts": ["dsh-desktop"]
  }
}
